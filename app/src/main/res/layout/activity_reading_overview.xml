<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFFFFF">
    <include layout="@layout/toolbar_layout" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/overview_explanation" android:textColor="#424242" android:textSize="16sp" />
        <TextView android:id="@+id/overviewStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingVertical="12dp" android:textColor="#212121" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/overviewAll" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/all_copies" />
        <Button android:id="@+id/overviewUnread" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/status_unread" />
        <Button android:id="@+id/overviewProgress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/status_in_progress" />
        <Button android:id="@+id/overviewFinished" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/status_finished" />
        <Button android:id="@+id/overviewLent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/status_lent" />

        <Button android:id="@+id/overviewRetry" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/retry_load" android:visibility="gone" />
    </LinearLayout></ScrollView>
</LinearLayout>
