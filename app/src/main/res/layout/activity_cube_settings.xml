<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
<include layout="@layout/toolbar_layout" />
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cube_settings_help" android:textColor="#424242" android:textSize="16sp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cube_columns" android:textColor="#212121" android:textSize="16sp" android:paddingTop="12dp" />
<Spinner android:id="@+id/cubeColumns" android:backgroundTint="#616161" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/cube_columns" />
<LinearLayout android:id="@+id/cubeNameFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
</LinearLayout></ScrollView>
<Button android:id="@+id/saveCubeSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_cube_settings" />
</LinearLayout>