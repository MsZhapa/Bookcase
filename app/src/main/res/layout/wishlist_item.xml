<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/book_item_background">
<TextView android:id="@+id/wishTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#212121" android:textStyle="bold" android:textSize="18sp" />
<TextView android:id="@+id/wishAuthor" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#424242" android:textSize="15sp" />
<TextView android:id="@+id/wishIsbn" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#424242" android:textSize="14sp" />
<TextView android:id="@+id/wishOwned" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8D3100" android:textSize="14sp" android:paddingTop="6dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<Button android:id="@+id/wishAddToLibrary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/wish_add_to_library" />
<Button android:id="@+id/wishRemove" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/wish_remove" />
</LinearLayout></LinearLayout>