<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFFFFF">

    <!-- 📌 Include Toolbar -->
    <include layout="@layout/toolbar_layout"/>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="10dp">

        <!-- 📚 Book Title -->
        <EditText android:textColorHint="#616161" android:backgroundTint="#616161" android:textColor="#212121"
            android:id="@+id/editTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter book title"/>

        <!-- ✍️ Author -->
        <EditText android:textColorHint="#616161" android:backgroundTint="#616161" android:textColor="#212121"
            android:id="@+id/editAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter author name"/>

        <!-- 📖 Description -->
        <EditText android:textColorHint="#616161" android:backgroundTint="#616161" android:textColor="#212121"
            android:id="@+id/editDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter book description"
            android:minLines="3"
            android:gravity="top"/>

        <!-- 📦 Cube Selection -->
        <TextView android:textColor="#212121"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Cube" android:layout_marginTop="10dp"/>
        <Spinner
            android:id="@+id/cubeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- 📚 Read Status -->
        <CheckBox
            android:id="@+id/editReadCheckBox" android:buttonTint="#4527A0" android:textColor="#212121"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark as Read"/>

        <include layout="@layout/page_progress_fields" />

        <!-- 🖼️ Book Cover Image -->
        <ImageView
            android:id="@+id/bookCoverImage"
            android:layout_width="150dp"
            android:layout_height="200dp"
            android:src="@drawable/books1"
            android:scaleType="centerCrop"
            android:layout_marginTop="10dp"/>

        <!-- 📤 Upload New Cover -->
        <Button
            android:id="@+id/uploadImageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload New Cover"/>

        <!-- 💾 Save Button -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Changes"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</ScrollView>
</LinearLayout>