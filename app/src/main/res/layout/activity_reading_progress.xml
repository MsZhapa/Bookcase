<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
    <include layout="@layout/toolbar_layout" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/progressCopyLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#212121" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp"
            android:text="@string/page_progress_help" android:textColor="#424242" android:textSize="16sp" />
        <CheckBox android:id="@+id/progressFinished" android:buttonTint="#4527A0" android:textColor="#212121" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="@string/finished_reading" />
        <include layout="@layout/page_progress_fields" />
        <TextView android:id="@+id/progressSaveStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#424242" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/saveReadingProgress" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/save_progress" android:enabled="false" />
        <Button android:id="@+id/retryProgressLoad" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/retry_load" android:visibility="gone" />
    </LinearLayout></ScrollView>
</LinearLayout>
